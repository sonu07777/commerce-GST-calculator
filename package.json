{
  "name": "commerce-calculator",
  "version": "0.1.1",
  "description": "A type-safe TypeScript financial calculation library for GST, discounts, invoices and pricing",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:check": "npm pack --dry-run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "keywords": [
    "gst",
    "discount",
    "invoice",
    "pricing",
    "typescript",
    "commerce",
    "calculator"
  ],
  "author": "Commerce Calculator",
  "license": "MIT",
  "engines": {
    "node": ">=18.18"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@types/node": "^20.0.0",
    "eslint": "^8.57.1",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.0.0"
  }
}
